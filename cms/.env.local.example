# MongoDB Connection String
# For Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/apk_elite
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/apk_elite?retryWrites=true&w=majority

# Server-Side Authentication Secrets (Keep private, never commit real values to git)
# Generate a 32+ character random secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your_super_secret_session_signing_key_min_32_characters_here

# Admin Login Credentials
ADMIN_USERNAME=admin
# Generate bcrypt hash using: node -e "console.log(require('bcryptjs').hashSync('YourStrongPasswordHere!', 10))"
ADMIN_PASSWORD_HASH=$2b$10$EXAMPLE_HASH_PLACEHOLDER

# CMS Portal Display Settings (Safe for public bundle)
NEXT_PUBLIC_APP_NAME="APK Elite Lead CMS"
NEXT_PUBLIC_PHONE="+918830167863"
