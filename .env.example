# ==============================================================================
# APK Elite Services - Environment Configuration Template
# ==============================================================================
# Copy this file to .env (for local development) or configure in Netlify Dashboard:
# Netlify -> Site Configuration -> Environment Variables
# ==============================================================================

# 1. MongoDB Atlas Database Connection (Required for permanent storage)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://apk_admin:<password>@cluster0.mongodb.net/apk_elite_services?retryWrites=true&w=majority
MONGODB_DB=apk_elite_services

# 2. CMS authentication (configure these server-side in Netlify)
# Generate AUTH_SECRET as a random value of at least 32 characters.
AUTH_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# 3. Instant Phone Lead Notifications (Optional - Telegram Bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 4. Email Lead Dispatcher (Web3Forms API key for info@apkeliteservices.in)
WEB3FORMS_ACCESS_KEY=101e2c51-0926-4dd3-b6e5-a04034ecca39
